[Unit]
Description={{ service.name }} backup client (kopia)

[Container]
Image=docker.io/kopia/kopia:0.23.1
ContainerName={{ service.name }}-backup
Pod={{ service.name }}.pod
Entrypoint=/bin/sh
Exec={{ config_dir }}/kopia-client.sh
Environment=TZ={{ tz }}
{# `:443` spelled out, although it is the scheme's default: kopia 0.23 hands the URL's
   authority to its gRPC resolver as it stands, and a bare host arrives there as
   `<host>:` -- "invalid target address, missing port after port-separator colon". #}
Environment=KOPIA_SERVER_URL=https://kopia.{{ domain }}:443
Environment=KOPIA_CLIENT_USERNAME={{ service.name }}
Environment=KOPIA_CLIENT_HOSTNAME={{ hostname }}
Environment=KOPIA_PIN_SERVER_CERT={{ '0' if acme else '1' }}
{# Quoted: systemd splits an unquoted Environment= on whitespace and keeps only the
   first word, which would reduce a multi-volume backup to its first volume. #}
Environment="KOPIA_PATHS={{ service.backup.paths | join(' ') }}"
Environment=KOPIA_SNAPSHOT_TIME={{ service.backup.schedule }}
{# Also exported by the script, and repeated here for HealthCmd: a health check is its
   own process, and `kopia repository status` has to read the same config and cache as
   the server the script started, not the defaults under the container's HOME. #}
Environment=KOPIA_CONFIG_PATH=/app/config/repository.config
Environment=KOPIA_CACHE_DIRECTORY=/app/cache
Environment=KOPIA_PERSIST_CREDENTIALS_ON_CONNECT=true
Environment=KOPIA_USE_KEYRING=false
Environment=KOPIA_KEEP_LATEST={{ service.backup.retention.latest }}
Environment=KOPIA_KEEP_DAILY={{ service.backup.retention.daily }}
Environment=KOPIA_KEEP_WEEKLY={{ service.backup.retention.weekly }}
Environment=KOPIA_KEEP_MONTHLY={{ service.backup.retention.monthly }}
Environment=KOPIA_KEEP_ANNUAL={{ service.backup.retention.annual }}
{# As an environment variable and not as a file under /run/secrets, because the value
   has to reach more than the start script: `podman exec` inherits the container's
   environment but not the script's, and both the HealthCmd below and every
   administrative kopia command are execs. Kopia's own persisted-credentials mechanism
   does not cover this case -- `repository connect server` writes repository.config but
   no password file beside it, so without this every exec dies at an interactive
   prompt ("inappropriate ioctl for device"). The value is then readable in this
   container's environment and in `podman inspect`, both of which are already reachable
   only by root and by the service user that owns the podman secret itself. #}
Secret=kopia_password,type=env,target=KOPIA_PASSWORD
Volume={{ config_dir }}/kopia-client.sh:{{ config_dir }}/kopia-client.sh:ro
Volume={{ volumes['backup-config'] }}:/app/config
Volume={{ volumes['backup-cache'] }}:/app/cache
{% for path in service.backup.paths %}
Volume={{ volumes[path] }}:/data/{{ path }}:ro
{% endfor %}
HealthCmd=kopia repository status
HealthOnFailure=kill
HealthStartPeriod=180s

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
