{# One per entry of `storage.disks` and `storage.parity`. The role mounts what the
   host declares and nothing else: it never partitions, formats or wipes a device. #}
[Unit]
Description={{ item.name }} ({{ item.mount }})

[Mount]
What={{ item.device }}
Where={{ item.mount }}
Type={{ item.fstype }}
{# `options` is optional per entry and defaults to what every disk declared today wants:
   a plain `defaults`, which is what the hand-stowed units carried. A disk that needs
   `noatime` or `nofail` declares it in `host.yml` rather than forcing a template change. #}
Options={{ item.options | default('defaults') }}

[Install]
RequiredBy=local-fs.target
