{# The maintenance run's parameters, rendered from `storage.snapraid.maintenance` and
   `storage.mail` in hosts/<host>/host.yml. Every script in /opt/storagebaby/maintenance
   sources this file; none of them carries a rendered value of its own, so a threshold is
   changed in git and converged and a hand-run script behaves exactly like the timer's.

   No secret belongs here -- it is 0644 and the log of a failed run may quote it. The SMTP
   password lives in /etc/msmtprc, 0600 root. #}
STORAGE_POOL={{ storage.pool.mount }}
BALANCE_TARGET_PERCENTAGE={{ storage.snapraid.maintenance.balance_threshold }}
SCRUB_PERCENT={{ storage.snapraid.maintenance.scrub_percent }}
SCRUB_OLDER_DAYS={{ storage.snapraid.maintenance.scrub_older_days }}
MAINTENANCE_MAIL_TO={{ storage.mail.to }}
MAINTENANCE_MAIL_FROM={{ storage.mail.from }}
