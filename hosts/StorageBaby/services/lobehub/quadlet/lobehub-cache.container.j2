[Unit]
Description=LobeHub cache

[Container]
Image=docker.io/library/redis:alpine
ContainerName=lobehub-cache
Pod=lobehub.pod
AutoUpdate=registry
Environment=TZ={{ tz }}
{# Upstream's own flags: an append-only log plus a 60-second snapshot. Everything in here
   is regenerable, so the persistence is a warm restart and not a backup -- which is why
   `cache` is absent from `backup.paths`. The image is the unpinned tag every other redis
   on this host runs: upstream's compose file says `redis:7-alpine`, nothing in lobehub
   needs that major, and holding one redis image instead of two is worth more here than
   matching a major upstream happens to test against. #}
Exec=redis-server --save 60 1000 --appendonly yes
Volume={{ volumes.cache }}:/data
HealthCmd=redis-cli ping
HealthOnFailure=kill

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
