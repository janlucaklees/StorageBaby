[Pod]
PodName=calino
{# Literal, not templated: the static check reads these lines out of the raw template to
   compare the published ports against the declared routes, and a templated line would
   make it compare the contract with itself.

   Two ports because the browser talks to both: it loads the app from 8085 and then makes
   its CalDAV calls to the proxy on 8086, from the app's origin. Unlike every other pod
   here, neither port is internal -- there is no server-side hop between them at all. #}
PublishPort=127.0.0.1:8085:8085
PublishPort=127.0.0.1:8086:8086
