[Unit]
Description=Push the kopia repository to its off-site replica
{# Requisite= and not Requires=, for the reason the dump units give: `podman exec`
   into a container that is not running fails anyway, and refusing to run is a
   louder, truer failure than starting the server to satisfy a dependency. #}
After=kopia.service
Requisite=kopia.service

[Service]
Type=oneshot
# /bin/sh, not a direct exec of the script: the role's config copy applies
# `u=rwX,go=rX` to every file under config/, and that `X` only keeps an execute bit
# a file already has *after* being staged on the target -- a freshly copied file
# lands there with none, so the script's own shebang is never reached. start.sh
# is invoked the same way, through Entrypoint=/bin/sh + Exec=, for the same reason.
ExecStart=/usr/bin/podman exec kopia /bin/sh {{ config_dir }}/sync.sh
