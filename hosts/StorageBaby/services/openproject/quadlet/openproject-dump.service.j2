[Unit]
Description=Dump the openproject database into the backups volume
{# Ordered after the database and conditional on it: a `podman exec` into a container that
   is not running fails, and without Requisite= the dump would still be attempted --
   leaving yesterday's file in /backups for the sidecar to snapshot as if it were
   tonight's. Requisite= does not start the database, it refuses to run without it. #}
After=openproject-database.service
Requisite=openproject-database.service

[Service]
Type=oneshot
{# Plain SQL and uncompressed, for the reason every dump here is: the sidecar snapshots it
   into a deduplicating repository, and a compressed dump differs in every byte from one
   night to the next. Restore with `psql --single-transaction --set ON_ERROR_STOP=on`. #}
ExecStart=/usr/bin/podman exec openproject-database sh -c 'pg_dump --clean --if-exists --no-owner --username={{ service.config.database_user }} --dbname={{ service.config.database_name }} > /backups/{{ service.config.database_name }}.sql.tmp && mv /backups/{{ service.config.database_name }}.sql.tmp /backups/{{ service.config.database_name }}.sql'
