[Pod]
PodName=openproject
{# Literal, not `{{ service.port }}`: the static check reads this line out of the raw
   template to compare the published ports against the declared routes, and a templated
   line would make it compare the contract with itself.

   Only the web process. The worker and the cron runner serve no HTTP at all, Postgres is
   on 5432 and redis on 6379, and all of them are reachable on the pod's loopback alone. #}
PublishPort=127.0.0.1:8081:8080
