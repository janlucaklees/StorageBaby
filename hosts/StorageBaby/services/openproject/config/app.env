# The environment every OpenProject process shares -- web, worker, cron and the seeder.
#
# This file is what upstream's compose expresses as a YAML anchor (`&app-environment`):
# four containers running the same image with the same configuration and different
# commands. Quadlet has no anchors, so the shared half lives here and each unit adds only
# `EnvironmentFile=` plus its own secrets. The seeder, which is a plain systemd unit rather
# than a Quadlet container, reads the same file through `podman run --env-file`.
#
# `config/` is copied verbatim and never templated, so the hostname is written out rather
# than taken from `routes[0].fqdn`. That is correct here and not a compromise: the service
# declares a full `klees.io` name of its own, so the value is the same on every host the
# folder is placed on.
#
# Secrets are absent by construction: this file is world-readable under
# /etc/cradle/openproject/. DATABASE_URL and SECRET_KEY_BASE arrive as podman secrets.

OPENPROJECT_HTTPS=true
OPENPROJECT_HOST__NAME=openproject.klees.io

# Redis as the Rails cache store, on the pod's own loopback.
OPENPROJECT_RAILS__CACHE__STORE=redis
OPENPROJECT_CACHE__REDIS__URL=redis://127.0.0.1:6379
