[Unit]
Description=OpenArchiver search index (meilisearch)

[Container]
{# Pinned: meilisearch changes its on-disk index format between versions, so the
   version stays a line in git rather than something a nightly timer decides. What is
   new is that the migration it implies is no longer the operator's -- see the
   upgrade flag below. OpenArchiver needs >= 1.14 (its v0.6.1 index-coverage check);
   upstream's compose ships v1.38, and this is the one tag librechat carries too, so
   the host holds one meilisearch. #}
Image=docker.io/getmeili/meilisearch:v1.56
ContainerName=openarchiver-meilisearch
Pod=openarchiver.pod
Environment=TZ={{ tz }}
Environment=MEILI_ENV=production
{# The whole of what makes a version bump of this image converge by itself.
   meilisearch refuses to open an index written by an older version, so before this
   line a bump was a crash-loop that an operator had to clear by hand. `--upgrade-db`
   (stabilised in v1.51 from `--experimental-dumpless-upgrade`, same behaviour)
   migrates the index in place on the first start of a new version and does nothing
   at all while the version is unchanged -- so it is idempotent, it stays, and every
   future bump is automatic too. It cannot read an index written before v1.12, which
   is far behind what this volume holds.
   The migration is NOT atomic: a kill in the middle can leave the index corrupt.
   That is what the start period below is for, and the floor is a reindex rather than
   data loss -- this index is derived from data that lives elsewhere. #}
Environment=MEILI_UPGRADE_DB=true
{# meilisearch takes the master key only from the environment, so the secret is injected
   as one rather than mounted under /run/secrets. Podman puts an env-type secret into
   the container at start; it is not stored in the container's config. #}
Secret=meili_master_key,type=env,target=MEILI_MASTER_KEY
Volume={{ volumes.meilisearch }}:/meili_data
{# /health is the unauthenticated liveness endpoint -- every other route needs the
   master key. The image ships curl for exactly this. #}
HealthCmd=curl -sf http://127.0.0.1:7700/health || exit 1
HealthOnFailure=kill
{# The index migration runs before the HTTP listener comes up, so /health answers
   nothing until it is done. With no start period at all podman killed the container
   mid-upgrade -- exactly the non-atomic case above. A start period only bounds the
   first healthy report, so an ordinary start is unaffected. #}
HealthStartPeriod=600s

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
