[Unit]
Description=OpenArchiver tika (attachment text extraction)

[Container]
{# Pinned, and the `-full` variant: OpenArchiver extracts text from mail attachments,
   which needs tika's OCR and the extra parsers the slim image leaves out.
   4.x because upstream's own compose pins `apache/tika:4.1.0-full` and its v0.6.1
   notes say both tika 3.x and 4.x are supported with automatic version detection.
   The same tag paperless now carries, so the host holds one tika. The probe below is
   unchanged and still correct: 4.1.0-full ships bash 5.3.9 and /bin/sh is still
   dash, checked by running the image. #}
Image=docker.io/apache/tika:4.1.0-full
ContainerName=openarchiver-tika
Pod=openarchiver.pod
Environment=TZ={{ tz }}
{# The tika image carries neither curl nor wget, so the probe is a bare TCP connect
   through bash's /dev/tcp -- and it has to say `bash`, because podman runs a HealthCmd
   through the image's `/bin/sh`, which here is dash and has no /dev/tcp at all. #}
HealthCmd=bash -c "exec 3<>/dev/tcp/127.0.0.1/9998"
HealthOnFailure=kill

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
