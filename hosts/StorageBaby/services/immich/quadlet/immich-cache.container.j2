[Unit]
Description=Immich cache and job queue

[Container]
Image=docker.io/library/redis:alpine
ContainerName=immich-cache
Pod=immich.pod
AutoUpdate=registry
Environment=TZ={{ tz }}
{# No volume and no persistence: job queue and cache only; Immich re-queues work from
   its scheduled jobs. #}
Exec=redis-server --save "" --appendonly no
HealthCmd=redis-cli --raw incr ping
HealthOnFailure=kill

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
