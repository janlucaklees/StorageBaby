[Unit]
Description=Dump the immich database into the backups volume
{# Ordered after the database and conditional on it: a `podman exec` into a container
   that is not running fails, and without Requisite= the dump would still be attempted
   -- leaving yesterday's file in /backups for the sidecar to snapshot as if it were
   tonight's. Requisite= does not start the database, it refuses to run without it, so
   a stopped pod makes the dump fail loudly instead of quietly going stale. #}
After=immich-database.service
Requisite=immich-database.service

[Service]
Type=oneshot
{# The same plain-SQL form the other three services dump in, and also the one Immich's
   own documentation gives for this database -- which matters here more than elsewhere:
   restoring a dump that carries `vector` columns needs the `search_path` rewrite in the
   README, and that rewrite only exists for plain SQL. `--clean --if-exists --no-owner`
   are meaningful at dump time in this format and would be pg_restore flags in any
   other. Uncompressed on purpose: a gzipped dump differs in every byte from one night
   to the next and dedups against nothing, which is the whole reason the app's own
   backup job is excluded from `upload`. See `ansible/roles/service/README.md`. #}
ExecStart=/usr/bin/podman exec immich-database sh -c 'pg_dump --clean --if-exists --no-owner --username={{ service.config.database_user }} --dbname={{ service.config.database_name }} > /backups/{{ service.config.database_name }}.sql.tmp && mv /backups/{{ service.config.database_name }}.sql.tmp /backups/{{ service.config.database_name }}.sql'
