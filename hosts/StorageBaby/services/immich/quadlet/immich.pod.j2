[Pod]
PodName=immich
{# The loopback port is Cradle's, derived and in no file; `container_port` is this pod's
   own. The static check reads this line out of the raw template and accepts a `publish_port`
   expression for a route and a literal only for a `tcp_ports` target. #}
PublishPort=127.0.0.1:{{ publish_port }}:{{ container_port }}
{# The machine learning URL is not an environment variable: it is a system setting
   stored in the database, and both a fresh install and the database migrated off the
   compose stack hold the compose service name `immich-machine-learning`. In a pod
   there is no such name and no DNS that answers for it, so it is aliased to the
   loopback the ML container actually listens on. Changing the setting in the admin UI
   instead would make a hand edit part of the deploy. #}
AddHost=immich-machine-learning:127.0.0.1
