[Unit]
Description=Nextcloud database

[Container]
Image=docker.io/library/postgres:17-alpine
ContainerName=nextcloud-database
Pod=nextcloud.pod
AutoUpdate=registry
Environment=TZ={{ tz }}
Environment=POSTGRES_DB={{ service.config.database_name }}
Environment=POSTGRES_USER={{ service.config.database_user }}
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/database_password
Secret=database_password
{# The image's Entrypoint is docker-entrypoint.sh and its Cmd is `postgres`, and that
   script ends in `exec gosu postgres "$@"` -- so a flag appended to the command
   reaches the server, which is the form the image documents.

   512M against the 128M initdb wrote into this database's own postgresql.conf: the
   database is 730M, 523M of it `oc_filecache`, the table every directory listing
   reads, so the hot set does not come close to fitting. Nor is page cache picking up
   the slack underneath it: `fincore` over the data tree found 33M of 752M resident,
   4.4%, this host being under enough memory pressure to keep nothing. So the misses
   are real reads off the SSD, and 512M holds the hot part somewhere nothing can
   evict it. #}
Exec=postgres -c shared_buffers={{ service.config.database_shared_buffers }}
Volume={{ volumes.database }}:/var/lib/postgresql/data
{# The dump timer writes here, and the backup sidecar mounts the same volume read-only:
   a database is backed up as a dump, never as its data directory. #}
Volume={{ volumes.backups }}:/backups
HealthCmd=pg_isready -U {{ service.config.database_user }} -d {{ service.config.database_name }}
HealthOnFailure=kill

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
