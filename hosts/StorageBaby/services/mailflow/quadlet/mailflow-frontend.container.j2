[Unit]
Description=Mailflow frontend
After=mailflow-backend.service
Wants=mailflow-backend.service

[Container]
{# The same fork and tag as the backend; the two always move together. #}
Image=ghcr.io/janlucaklees/mailflow-frontend:4.4.1-archive.2
ContainerName=mailflow-frontend
Pod=mailflow.pod
Environment=TZ={{ tz }}
{# Since 4.4 the frontend is Caddy, not nginx. Its start script (`mailflow-start`, from
   upstream's `frontend/caddy/start.sh`) points the proxy at BACKEND_HOST:BACKEND_PORT,
   defaulting to the Compose name `backend:3000`, which does not resolve in a pod. Upstream
   added the two variables for this case -- its comment names "Podman" -- so no
   `AddHost=backend:127.0.0.1` alias of the kind immich uses. #}
Environment=BACKEND_HOST=127.0.0.1
Environment=BACKEND_PORT=3000
{# HTTP on port 80 only: no 443 listener and no self-signed certificate, for a reverse
   proxy that terminates TLS in front. So this route is plain HTTP, unlike kopia and
   collabora, which keep their own TLS because their protocols leave them no choice.
   `NGINX_TLS=off` would still mean the same; TLS_MODE is the name since 4.4. #}
Environment=TLS_MODE=off
{# Caddy's own health endpoint, bound to loopback inside the container -- upstream's compose
   healthcheck. busybox wget, which caddy:2-alpine has; it has no curl. #}
HealthCmd=wget -q --spider http://127.0.0.1:2080/healthz || exit 1
HealthOnFailure=kill

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
