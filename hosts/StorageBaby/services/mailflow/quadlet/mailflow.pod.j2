[Pod]
PodName=mailflow
{# Literal, not `{{ service.port }}`: the static check reads this line out of the raw
   template to compare the published ports against the declared routes, and a templated
   line would make it compare the contract with itself.

   The frontend's port 80, and only it. The backend on 3000, Postgres on 5432 and redis on
   6379 are reachable on the pod's loopback and nowhere else -- the browser never talks to
   the backend directly, nginx proxies every API path to it. #}
PublishPort=127.0.0.1:3003:80
