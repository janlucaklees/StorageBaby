[Unit]
Description=Daily librechat database dump

[Timer]
{# 02:30, the same as every other dump on this platform: half an hour before the backup
   sidecars start at 03:00, so the files the snapshot carries are tonight's. #}
OnCalendar=*-*-* 02:30:00
Persistent=true

[Install]
WantedBy=timers.target
