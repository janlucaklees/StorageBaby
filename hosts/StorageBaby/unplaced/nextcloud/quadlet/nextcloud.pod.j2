[Pod]
PodName=nextcloud
{# Literal, not `{{ routes[n].port }}`: the static check reads these lines out of the
   raw template to compare the published ports against the declared routes. Two of
   them, because this is the one service with two hostnames -- nginx answers on 80
   inside the pod for the `nextcloud` route, collabora on 9980 for its own. #}
PublishPort=127.0.0.1:8280:80
PublishPort=127.0.0.1:9980:9980
