[Pod]
PodName=openarchiver
{# Literal, not `{{ service.port }}`: the static check reads this line out of the raw
   template to compare the published ports against the declared routes. The two numbers
   differ on purpose -- the app listens on 3000, which yuzukam already publishes on this
   host, so the route's loopback port is 3001. #}
PublishPort=127.0.0.1:3001:3000
