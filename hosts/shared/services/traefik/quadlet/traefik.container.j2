[Unit]
Description=Traefik reverse proxy

[Container]
Image=docker.io/library/traefik:v3
ContainerName=traefik
AutoUpdate=registry
Network=host
Exec=--api --ping=true \
  --providers.file.directory=/etc/traefik/dynamic.d --providers.file.watch=true \
  --entrypoints.web.address=:80 --entrypoints.websecure.address=:443 \
{# Traefik v3 reads a whole request within 60 s by default (v2 had no limit). A Kopia
   snapshot is one gRPC request that streams the upload for as long as it takes, so the
   backup sidecars died at the minute with `RST_STREAM ... INTERNAL_ERROR: EOF` on any
   volume that did not fit in it. 0 is no limit; the kopia README has the measurement. #}
  --entrypoints.websecure.transport.respondingTimeouts.readTimeout=0 \
  --entrypoints.traefik.address=127.0.0.1:{{ service.port }} \
{# One entrypoint per plain-TCP port placed on this host, `tcp-<port>` on the host's own
   address. The list is the host's placement, not this service's business, so the playbook
   collects it into `placed_tcp_ports` -- and because it is rendered here, placing or
   unplacing a TCP port changes this unit and restarts Traefik once.
   `<tcp_bind_address>:<port>` and not the wildcard `:<port>`: a wildcard listener and the
   pod's `127.0.0.1:<port>` are mutually exclusive on Linux, and a port that forwards to
   itself on loopback is what an FTP passive range needs. One concrete routable address
   here, loopback in the pod, and both fit -- Traefik is still the only process on a
   routable address. `tcp_bind_address` defaults to `ansible_default_ipv4.address` and is
   overridable in `host.yml`. The matching routers are rendered by the `service` role into
   `dynamic.d/<name>-tcp.yml`. #}
{% for port in placed_tcp_ports | default([]) %}
  --entrypoints.tcp-{{ port }}.address={{ tcp_bind_address }}:{{ port }} \
{% endfor %}
  --entrypoints.web.http.redirections.entrypoint.to=websecure \
  --entrypoints.web.http.redirections.entrypoint.scheme=https{% if acme %} \
  --certificatesresolvers.porkbun.acme.email={{ acme_email }} \
  --certificatesresolvers.porkbun.acme.storage=/letsencrypt/acme.json \
  --certificatesresolvers.porkbun.acme.dnschallenge.provider=porkbun \
  --certificatesresolvers.porkbun.acme.dnschallenge.resolvers=1.1.1.1:53,8.8.8.8:53{% endif %}

Environment=TZ={{ tz }}
Environment=PORKBUN_API_KEY_FILE=/run/secrets/porkbun_api_key
Environment=PORKBUN_SECRET_API_KEY_FILE=/run/secrets/porkbun_secret_api_key
Secret=porkbun_api_key
Secret=porkbun_secret_api_key
{# The dashboard's htpasswd line, read by the basicAuth middleware the `service` role
   renders into the dashboard's route file as `usersFile: /run/secrets/dashboard_htpasswd`.
   A `route.basic_auth` secret is always one of Traefik's own: Traefik is the process that
   reads the file, and a rootless user cannot see another user's podman secrets. #}
Secret=dashboard_htpasswd
HealthCmd=wget --spider -q http://127.0.0.1:{{ service.port }}/ping || exit 1
HealthOnFailure=kill
Volume={{ volumes.letsencrypt }}:/letsencrypt
Volume=/etc/storagebaby/traefik/dynamic.d:/etc/traefik/dynamic.d:ro
{# Only where there is no ACME: `host_base` makes one stable self-signed default
   certificate there and points `tls.stores.default` at these paths, so Traefik stops
   inventing a new one on every start. On an ACME host the directory does not exist,
   and a bind mount of a missing path is one rootless podman cannot create. #}
{% if not (acme | bool) %}
Volume=/etc/storagebaby/traefik/certs:/etc/traefik/certs:ro
{% endif %}

[Service]
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
