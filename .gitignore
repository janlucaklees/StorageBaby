mounts/
.env
.stfolder
# Everything Claude Code keeps here is local state -- worktrees, locks, caches -- except
# the skills, which are part of the repository: a project-local skill that is not tracked
# is invisible to a fresh clone and to every other session.
.claude/*
!.claude/skills/
*.dump
*.sql
*.secret
__pycache__/
.pytest_cache/
hosts/test-*/secrets/
tests/fixtures/sources/*/**/secrets.sops.yaml
