# Read by mise (`_.file = ".env"` in mise.toml), which puts them in the environment the
# tasks run with -- and from there into the devtools container, by the bare `-e NAME`
# pass-through. All three are optional; the values below are the defaults, which live in
# tests/integration/molecule/test-ci/molecule.yml and not in mise.toml. A value set here
# wins over one set in the shell, so comment a line out rather than overriding it.
MOLECULE_VM_MEMORY_MIB=12288
MOLECULE_VM_VCPUS=4
# Which host folder the integration scenario converges: `test-a` places every service,
# `test-ci` the subset that fits a GitHub runner.
MOLECULE_HOST=test-a
