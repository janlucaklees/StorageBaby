# Read by the Makefile as make variables (`-include .env`), which is what gets them into
# the devtools container. All three are optional; the values below are the defaults.
MOLECULE_VM_MEMORY_MIB=12288
MOLECULE_VM_VCPUS=4
# Which host folder the integration scenario converges: `test-a` places every service,
# `test-ci` the subset that fits a GitHub runner.
MOLECULE_HOST=test-a
